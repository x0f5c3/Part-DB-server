# ─────────────────────────────────────────────────────────────────────────────
# Part-DB Frontend — Environment Variables Example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your values.
# NEVER commit `.env.local` to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required for auth + optional direct DB access) ──────────────────
# Find these in Supabase Dashboard → Project Settings → API.

# Your project's URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# The anon/public key for your project (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Rust backend API ──────────────────────────────────────────────────────────
# URL of the running Rust Axum backend.  Defaults to /api (same-origin proxy).
NEXT_PUBLIC_API_URL=http://localhost:3000/api
