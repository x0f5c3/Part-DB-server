# ─────────────────────────────────────────────────────────────────────────────
# Part-DB Backend — Supabase Configuration Example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your Supabase project values.
# Find these values in the Supabase Dashboard under Project Settings → API.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Direct PostgreSQL connection to your Supabase project.
# Format:  postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Use the "Connection string" value from Project Settings → Database.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Authentication ────────────────────────────────────────────────────────────
# The JWT secret shown under Project Settings → API → JWT Settings.
# All tokens issued by Supabase Auth are signed with this secret (HS256).
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000

# ── Connection pool ───────────────────────────────────────────────────────────
DB_MAX_CONNECTIONS=10
DB_CONNECT_TIMEOUT=30
